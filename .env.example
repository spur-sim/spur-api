# Copy to .env and adjust as needed. All settings are optional in Phase 1.

# Set to true to require `Authorization: Bearer <key>` matching one of
# SPUR_API_API_KEYS on every request except /healthz and /readyz.
SPUR_API_AUTH_ENABLED=false
# SPUR_API_API_KEYS=["dev-key-1","dev-key-2"]

# Not used yet - Phase 2 adds Postgres/Redis-backed persistence and a
# background worker.
# SPUR_API_DATABASE_URL=postgresql+asyncpg://spur:spur@localhost:5432/spur_api
# SPUR_API_REDIS_URL=redis://localhost:6379/0
